# Virtual environments. Both spellings: the rule used to be `venv/` only, which
# silently failed to cover the `.venv/` this project actually uses.
venv/
.venv/
env/
.env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/

# VS Code
.vscode/

# Build output, including compiled translation catalogues (tools/build_mo.py)
build/

# Installer output (packaging/build_win)
installer/

# Stamped from the git commit count at build time by tools/gen_version_build.py.
# Generated rather than committed, so it can never disagree with the checkout.
pdfarranger_qt/version_build

# Test and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Test artefacts
tests/exporter/out.pdf

# macOS installer output. The Windows build writes into installer/ and the
# Linux one into dist/, both already ignored above, but packaging/build_mac
# leaves the finished image in the project root. The wildcard also covers
# create-dmg's rw.<pid>.*.dmg scratch image, which it removes on a clean run
# and leaves behind on an interrupted one.
*.dmg
*.pkg

# pkgbuild staging directory for the pkg format (packaging/build_mac)
packages/

# macOS Finder metadata
.DS_Store
