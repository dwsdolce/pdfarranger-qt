msgstr "Непрерывно"

msgid "Continuous Scroll"
msgstr "Непрерывная прокрутка"

msgid "Copied"
msgstr "Скопировано"

msgid "Copy"
msgstr "Копировать"

msgid "Copy Link Address"
msgstr "Копировать адрес ссылки"

msgid "Copy Text"
msgstr "Копировать текст"

msgid "Copy the pages you want to merge in first."
msgstr "Сначала скопируйте страницы, которые нужно вставить."

msgid "Could not open a new window."
msgstr "Не удалось открыть новое окно."

msgid "Could not save:"
